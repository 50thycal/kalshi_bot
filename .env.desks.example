# Configuration reference only: DeskSettings does not auto-load .env files.
# Set these on the dedicated desk service through your host's secret manager.
# Never reuse worker DATABASE_URL, Kalshi keys, Evo credentials, or ops transport.

DESKS_DATABASE_URL=postgresql+psycopg://DESK_USER:REPLACE_ME@DB_HOST:5432/DESK_DATABASE
DESKS_ROUND_ID=desks-round-1

# REQUIRED: supply three DIFFERENT cryptographically random tokens, each >=32 chars.
# Blank intentionally: this example cannot boot with known public credentials.
DESKS_OPERATOR_TOKEN=
DESKS_CHATGPT_TOKEN=
DESKS_CLAUDE_TOKEN=

# Deployment bind. For local-only development use 127.0.0.1.
DESKS_HOST=0.0.0.0
# Set this to Railway's actual PORT; omit DESKS_PORT to use the platform fallback.
DESKS_PORT=8090

# Defaults remain disabled until dedicated deployment evidence and common launch.
DESKS_LIVE_ENABLED=false
DESKS_EXISTING_WORKERS_ISOLATED=false
DESKS_EXTERNAL_RUNNERS_VERIFIED=false

# Public HTTPS receiving endpoint, stored as a secret. No URL credentials/fragments.
# After setup an operator must POST {} to /api/alerts/test and verify delivery.
DESKS_ALERT_WEBHOOK_URL=

DESKS_KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# 0 deliberately blocks live startup. Use distinct, restricted non-primary accounts.
DESKS_CHATGPT_SUBACCOUNT=0
DESKS_CLAUDE_SUBACCOUNT=0
DESKS_CHATGPT_KALSHI_KEY_ID=
DESKS_CLAUDE_KALSHI_KEY_ID=
# Set the complete PEM value using a multiline secret in the hosting platform.
DESKS_CHATGPT_KALSHI_PRIVATE_KEY=
DESKS_CLAUDE_KALSHI_PRIVATE_KEY=

DESKS_RESEARCH_INTERVAL_SECONDS=3600
DESKS_TICK_SECONDS=15

# No new paid research allowance is authorized. Existing external session runners
# must actually be connected and verified; the bridge itself is not a scheduler.
DESKS_MONTHLY_RESEARCH_BUDGET_USD=0
DESKS_CHATGPT_PROVIDER=external
DESKS_CLAUDE_PROVIDER=external

# Optional future paid providers require explicit approval of an equal budget,
# dedicated model keys, exact model IDs, and verified current per-million pricing.
DESKS_CHATGPT_MODEL=
DESKS_CLAUDE_MODEL=
DESKS_CHATGPT_MODEL_KEY=
DESKS_CLAUDE_MODEL_KEY=
DESKS_CHATGPT_INPUT_USD_PER_MILLION=0
DESKS_CHATGPT_OUTPUT_USD_PER_MILLION=0
DESKS_CLAUDE_INPUT_USD_PER_MILLION=0
DESKS_CLAUDE_OUTPUT_USD_PER_MILLION=0
