FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.155.1
ARG CLAUDE_VERSION=2.1.278
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ca-certificates gosu \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@${CODEX_VERSION} @anthropic-ai/claude-code@${CLAUDE_VERSION} \
    && npm cache clean --force
RUN python3 -m venv /opt/desk-venv
WORKDIR /opt/kalshi_bot
COPY requirements.txt ./
RUN /opt/desk-venv/bin/pip install --no-cache-dir -r requirements.txt
COPY kalshi_bot ./kalshi_bot
COPY deploy/desks/runner-entrypoint.sh /usr/local/bin/desk-runner-entrypoint
RUN chmod 755 /usr/local/bin/desk-runner-entrypoint \
    && useradd --uid 10001 --home-dir /data/model-home --no-create-home desk \
    && codex --version && claude --version \
    && codex exec --help | grep -q -- '--ignore-user-config' \
    && claude --help | grep -q -- '--json-schema'
ENV PATH="/opt/desk-venv/bin:/usr/local/bin:/usr/bin:/bin" \
    HOME="/data/model-home" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DISABLE_AUTOUPDATER=1
ENTRYPOINT ["/usr/local/bin/desk-runner-entrypoint"]
# Setup mode: no job claims or model calls. Switch only after login/billing checks.
CMD ["sleep", "infinity"]
