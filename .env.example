# ---------------------------------------------------------------------------
# Kalshi Trading Bot — environment configuration (Scanner MVP)
# Copy to .env for local runs. NEVER commit a real private key.
# ---------------------------------------------------------------------------

# Kalshi environment: demo | production. Start with demo until connectivity works.
KALSHI_ENV=demo

# Kalshi API credentials.
KALSHI_API_KEY_ID=your-api-key-id
# RSA private key (PEM). In Railway, paste as a single line with \n escapes,
# or provide a real multi-line value. Loaded with the cryptography library.
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Postgres connection string (Railway provides this automatically).
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Operating mode: scanner | paper | approval | live | weather
BOT_MODE=scanner
# Master safety switch. Keep `true` until live trading is explicitly enabled.
KILL_SWITCH=true

# Risk limits. MAX_ORDER_SIZE is in contracts; the rest are in dollars.
MAX_ORDER_SIZE=1
MAX_MARKET_EXPOSURE=25
MAX_TOTAL_EXPOSURE=100
MAX_DAILY_LOSS=25

# Scan cadence.
SCAN_INTERVAL_SECONDS=300
# RUN_ONCE=true runs a single scan and exits; false loops forever.
RUN_ONCE=false

# --- Scanner tuning (optional; sane defaults live in kalshi_bot/config.py) ---
# Comma-separated target category names.
# Broad set of categories to surface less-efficient markets where edges may exist.
TARGET_CATEGORIES=Economics,Financials,Companies,Climate and Weather,Commodities,Science and Technology
# Optional comma-separated series-ticker prefixes (e.g. KXFED,KXCPI) used when
# the market object has no usable `category` field.
TARGET_SERIES_PREFIXES=
MAX_SPREAD_CENTS=5
# Lower liquidity floors so thinner (often less efficiently priced) markets qualify.
MIN_VOLUME=25
MIN_OPEN_INTEREST=10
MIN_HOURS_TO_CLOSE=1
# Deep-scan budget per cycle, and a per-category cap so the budget is spread across
# categories (stratified) instead of only the highest-volume econ markets.
MAX_MARKETS_PER_SCAN=75
MAX_MARKETS_PER_CATEGORY=12
ORDERBOOK_DEPTH=10
STALENESS_SECONDS=120
LOG_LEVEL=INFO

# --- Paper trading (only used when BOT_MODE=paper) ---
# Comma-separated strategies run as PARALLEL books (one position per market per strategy):
#   buy_favorite | buy_yes | buy_no | momentum | reversion | ladder
PAPER_STRATEGIES=buy_favorite,momentum,reversion,ladder
# Minimum cost-aware edge (cents) required for the edge models to enter.
# 1 = low bar so the edge models fire readily (validation); raise to ~3 to demand
# edges that clear realistic costs once you trust the models.
PAPER_MIN_EDGE_CENTS=1
# Momentum: lookback window for the drift fit, how far forward to project that drift
# (bigger -> larger predicted moves -> fires more), and default direction.
PAPER_MOMENTUM_LOOKBACK_HOURS=6
PAPER_MOMENTUM_PROJECT_HOURS=24
PAPER_MOMENTUM_DIRECTION=momentum
# Contracts per simulated entry (capped by available order-book depth)
PAPER_ORDER_SIZE=1
# Simulated bankroll (dollars); paper trading ignores the real account balance
PAPER_STARTING_BANKROLL=1000
PAPER_MAX_OPEN_POSITIONS=50
# Close an open paper trade at the current bid after this many hours (fractional ok).
# Lower it (e.g. 1-2) for fast iteration; raise it to give far-dated markets room.
PAPER_MAX_HOLD_HOURS=6
# Optional take-profit / stop-loss in cents of price move (blank = disabled)
PAPER_TAKE_PROFIT_CENTS=
PAPER_STOP_LOSS_CENTS=
# Model Kalshi trading fees on simulated fills
PAPER_FEES_ENABLED=true

# --- Market-making SELL book (only used when BOT_MODE=mmsell) ---
# Forward-tests the backtested maker edge: rest an ASK to sell yes on overpriced cheap/
# underdog contracts (= buy NO at the no-bid, the maker price) and HOLD to settlement.
# Entry band is on the yes MIDPOINT in cents; the backtest edge lives ~5-40c (0-3c pennies
# die to fees, favorites >=65c get picked off). Paper ASSUMES the resting ask fills, so it
# validates whether the +EV persists out-of-sample on new markets — NOT queue/fill realism
# (that needs a small live test). Hold-to-settlement is optimal (exit sweep: TP/SL only hurt),
# so leave PAPER_TAKE_PROFIT_CENTS / PAPER_STOP_LOSS_CENTS unset; if set, they apply here too.
# MMSELL_ENTRY_LO_CENTS=5
# MMSELL_ENTRY_HI_CENTS=40
# MMSELL_MIN_VOLUME=100
# MMSELL_MIN_HOURS_TO_CLOSE=1
# MMSELL_MAX_HOURS_TO_CLOSE=336          # 14 days — bound how long capital is tied up
# MMSELL_TOP_EVENTS=150                  # scan cap per cycle (most-liquid events)
# MMSELL_MAX_OPEN_POSITIONS=200          # diversification is the real risk control
# MMSELL_SKIP_SERIES=KXMVE,KXHIGH,KXLOW  # skip parlays + weather (its own book)
# Ride-along: run the mmsell PAPER book INSIDE the weather/live cycle (throttled) so it collects
# alongside the weather books without a mode switch and without any real money. ON by default
# (forward-testing the maker edge); set false to disable.
# MMSELL_PAPER_ENABLED=true
# MMSELL_INTERVAL_MINUTES=30             # how often the ride-along entry scan runs

# --- Weather mode (only used when BOT_MODE=weather) ---
# Track up to N daily high-temperature cities by volume (there are ~7).
WEATHER_TOP_N=10
# Enter at these hours-to-settlement snapshots (one paper trade per book per window).
# Include an early (morning) window: daily highs settle next morning, so 20h ~ local
# morning (market still uncertain, where a forecast can disagree/win), 14h ~ around the
# high, 8h ~ evening (near-certain). Entering only late (e.g. 12/8/4) misses the edge.
WEATHER_ENTRY_HOURS=20,14,8
# Base weather books: `favorite` buys the market's top bucket; `nws` buys the bucket the raw
# NWS forecast points to; `cal` buys the bucket a per-city bias-corrected forecast points to.
# `favorite` and `nws` were PRUNED after paper P&L confirmed both bleed the cost floor
# (~-$39 / ~-$34); only `cal` remains as a base book. The con/dist/favband/cwin books run via
# their own flags below (con is the one showing +EV). NWS forecast COLLECTION is unaffected.
WEATHER_STRATEGIES=cal
# `cal` bias correction: offset = mean(actual_high - forecast) per city, learned from
# settled history and shrunk toward 0 by n/(n+SHRINKAGE) so a couple of events don't
# overcorrect. Only cities with >= MIN_EVENTS settled pairs get a non-zero offset.
# Highs and lows are learned independently.
WEATHER_BIAS_SHRINKAGE=3.0
WEATHER_BIAS_MIN_EVENTS=1
# Daily LOW temperature markets (KXLOWT*): PRUNED — the whole low program bled ~-$88 in paper
# with no +EV sub-book, so lows are off by default. Set true (+ WEATHER_LOW_SERIES if a series
# guess is wrong) to resume tracking/trading lows.
WEATHER_TRACK_LOWS=false
WEATHER_LOW_SERIES=
# Intraday settlement-station observations (running max/min so far today) — the
# late-day reality check the market can lag. Stored in weather_observations.
WEATHER_OBS_ENABLED=true
WEATHER_OBS_INTERVAL_MINUTES=15
# Open-Meteo ensemble members (free, no key): the forecast *distribution* behind
# P(temperature lands in bucket). Stored in weather_ensembles. Models update ~6-hourly.
WEATHER_ENSEMBLE_ENABLED=true
# GFS + ECMWF + ICON-EPS + GEM-EPS: wider model disagreement = better sigma for `dist`.
# Unrecognized ids fail soft (logged + skipped), so adding models is low-risk.
WEATHER_ENSEMBLE_MODELS=gfs_seamless,ecmwf_ifs025,icon_seamless,gem_global
WEATHER_ENSEMBLE_INTERVAL_MINUTES=60
# Polymarket cross-market signal: the `weather_pm` book trades Kalshi toward
# Polymarket's implied price, but ONLY for cities whose settlement station matches
# Kalshi (verified LAX/MIA/AUS — NYC/CHI/DEN use different stations). Polymarket data
# is read-only signal; we never trade Polymarket (it is geofenced). Stored separately
# in polymarket_snapshots.
WEATHER_POLYMARKET_ENABLED=true
WEATHER_PM_CITIES=LAX,MIA,AUS
WEATHER_PM_INTERVAL_MINUTES=5
# Per-city entry-window book (weather_cwin): buy the HIGH favorite once at each city's
# backfill-validated best hours-to-close (h18 for CHI/LAX/DEN survived an out-of-sample
# holdout; map: CHI/LAX/DEN=18, NYC/PHIL=10, MIA/AUS=24). Runs alongside the fav/nws/cal
# books as a separate book so the city-timed entry can be compared live.
WEATHER_CITY_WINDOW_ENABLED=true
WEATHER_CITY_WINDOWS=CHI:18,LAX:18,DEN:18,NYC:10,MIA:24,AUS:24,PHIL:10
# Obs-confirmed late-entry book (weather_obs / weather_low_obs): after the local cutoff
# hour the day's high/low has usually formed, so the station's running max/min is a
# near-locked bound the market lags. Buy the bucket containing it once, if its ask is
# still <= the cap. (Entry study: late + cheap was +EV; the only live-positive signal.)
WEATHER_OBS_ENTRY_ENABLED=true
WEATHER_OBS_HIGH_AFTER_HOUR=16
WEATHER_OBS_LOW_AFTER_HOUR=7
WEATHER_OBS_ASK_CAP=90
# Distribution edge book (weather_dist / weather_low_dist): price every bucket off the
# stored Open-Meteo ensemble (a Gaussian kernel per member, blended across models) and buy
# the single bucket whose model probability most beats its ask, net of fee, by >= min-edge.
# sigma is the kernel width (deg F) — kept modest so the model stays tighter than the
# market's overdispersed ladder (backfill study #6).
WEATHER_DIST_ENABLED=true
WEATHER_DIST_SIGMA=1.5
WEATHER_DIST_MIN_EDGE_CENTS=5
# Consensus / layered book (`weather_con` / `weather_low_con`): make the independent signal
# families (fc=hrrr|nws, ens, obs, pm) CONVERGE before trading. Offline-validated two-mode
# rule: HIGH at early windows -> skill-weighted blend (obs/pm weighted above forecasts),
# trade only when it DEVIATES from the favorite; LOW / HIGH-late -> trade only a near-
# unanimous K agreement that lands ON the favorite (a near-lock filter), else skip.
WEATHER_CONSENSUS_ENABLED=true
WEATHER_CONSENSUS_TOL=1
WEATHER_CONSENSUS_WEIGHTS=fc=1,ens=1,obs=2,pm=2
WEATHER_CONSENSUS_EARLY_WINDOWS=20,14
WEATHER_CONSENSUS_EARLY_MIN_MASS=3
WEATHER_CONSENSUS_CONFIRM_K=4
# Full bucket-ladder price snapshots (the market's implied distribution), per event.
# Rides along with the scan cycle (no extra API calls); 5 min = finer price paths for
# the offline exit/entry replay studies.
WEATHER_LADDER_INTERVAL_MINUTES=5
# Kalshi history backfill: pull settled temperature markets + hourly candlesticks
# from the Kalshi REST archives into the SEPARATE backfill_* tables (provenance never
# mixes with live-collected snapshots). Bounded chunk per cycle; converges in <1 day.
WEATHER_BACKFILL_ENABLED=true
WEATHER_BACKFILL_DAYS=120
WEATHER_BACKFILL_MARKETS_PER_CYCLE=40
# Candle granularity in minutes (1, 60 or 1440). 60 keeps a year of history ~1.5M rows.
WEATHER_BACKFILL_PERIOD_MINUTES=60
# Persisted forecast->settlement validation dataset (weather_forecast_outcomes): at
# settlement, replay the raw tables into one labeled row per intraday cycle (off the
# trading path). Drains a few settled events per cycle; max_htc caps how early a cycle
# is kept. Inspect with scripts/weather_validation.py.
WEATHER_VALIDATION_ENABLED=true
WEATHER_VALIDATION_EVENTS_PER_CYCLE=25
WEATHER_VALIDATION_MAX_HTC=24
# Collect NWS daily-high forecasts alongside (stored in weather_forecasts).
WEATHER_FORECAST_ENABLED=true
# HRRR (NOAA hourly, high-res, <=48h CONUS) point forecast via Open-Meteo, stored in
# weather_forecasts with source='openmeteo_hrrr' and graded head-to-head vs NWS/market in
# the validation dataset. COLLECT + GRADE ONLY — no book trades on it yet.
WEATHER_HRRR_ENABLED=true
WEATHER_HRRR_INTERVAL_MINUTES=15
# api.weather.gov requires a descriptive User-Agent — set this to your app + contact email.
NWS_USER_AGENT=kalshi-bot (you@example.com)
# On startup in weather mode, abandon any open paper positions from prior experiments.
PAPER_ABANDON_FOREIGN_ON_START=true

# --- Live real-money execution (INERT by default) ---------------------------------
# The live layer mirrors allowlisted paper entries into REAL Kalshi orders. It places
# NOTHING until ALL of these are true: BOT_MODE=live, KILL_SWITCH=false, LIVE_ENABLED=true,
# AND a non-empty LIVE_STRATEGIES allowlist. Live mode also refuses to start without an
# available balance. Start tiny (LIVE_MAX_ORDER_DOLLARS) and with one book in the allowlist.
LIVE_ENABLED=false
# Allowlist of strategy PREFIXES permitted to trade real money (comma-separated). Empty =
# nothing trades. Book-agnostic — any strategy string works, e.g. "weather_low_fav,weather_dist".
LIVE_STRATEGIES=
# Optional narrowing on top of the allowlist (empty = all). The cross-validated edge is
# late-window high favorites in stable cities, e.g. LIVE_CITIES=DEN,MIA,AUS,CHI,LAX and
# LIVE_WINDOWS=8 (see docs/RESEARCH_JOURNAL.md and docs/LIVE_DRYRUN.md).
LIVE_CITIES=
LIVE_WINDOWS=
# Entry fill style: "marketable" (limit at the ask, crosses ~immediately) | "passive"
# (rest a limit below the ask to earn the spread; cancels if unfilled past the timeout).
LIVE_ENTRY_STYLE=marketable
LIVE_PASSIVE_OFFSET_CENTS=2
# Marketable entries cross the spread up to this many cents above the best ask, and the count
# is sized to the depth available WITHIN that band. Stops a thin best-ask level (e.g. 1 contract)
# from shrinking the dollar-cap size to a token fill, while keeping the worst price bounded. 0
# = take only the best-ask level (old behavior).
LIVE_ENTRY_SLIPPAGE_CENTS=2
LIVE_ORDER_TIMEOUT_SECONDS=600
# Per-order dollar cap -> qty = floor(cap / price), then capped by in-band depth, risk and
# MAX_ORDER_SIZE.
LIVE_MAX_ORDER_DOLLARS=5
# Exit handling: "settlement" (hold to cash settlement, no exit order) | "tp_sl" (place real
# closing orders on take-profit / stop-loss / break-even). The cents levels apply in tp_sl mode.
LIVE_EXIT_MODE=settlement
LIVE_TAKE_PROFIT_CENTS=
LIVE_STOP_LOSS_CENTS=
LIVE_BREAK_EVEN_ARM_CENTS=
# Per-entry-window take-profit (tp_sl mode), e.g. "20:5,14:20": the h20 entry scalps a tight
# +5c, the h14 (higher-conviction) entry runs to +20c. A listed window is TP-ONLY (no stop —
# stops whipsaw these high-win favorites); unlisted windows use the global TP/SL/BE above.
LIVE_TAKE_PROFIT_BY_WINDOW=
# Cap real exposure to ONE open position per event (city-day): skip a later-window entry while
# an earlier-window position on the same event is still open (the tight h20 TP usually clears it
# before h14; if h20 is stuck, h14 is skipped rather than doubling down).
LIVE_ONE_POSITION_PER_EVENT=false
# Hardened exit (tp_sl mode): exits close a YES position by BUYing NO (Kalshi's canonical close)
# and re-attempt until the position is flat. Re-attempts escalate the price by SLIPPAGE_CENTS to
# force a fill. MARKET fallback is a best-effort last resort (Kalshi market-order fields
# unconfirmed; keep OFF). MAX_ATTEMPTS bounds re-tries per position/day, then it holds to settlement.
LIVE_EXIT_SLIPPAGE_CENTS=0
LIVE_EXIT_USE_MARKET_FALLBACK=false
LIVE_EXIT_MAX_ATTEMPTS=3
# Circuit breaker: block new entries once realized P&L today <= -MAX_DAILY_LOSS.
LIVE_KILL_ON_DAILY_LOSS=true

# --- Live/paper PARALLEL TWIN books (docs/LIVE_PAPER_TWIN.md) ----------------------
# Standing policy: every strategy promoted to real money runs a FRESH paper book beside it,
# started at the same instant and parameterized to the LIVE knobs (live maker price rule, live
# dollar sizing, live open cap, live spread gate) — so the ONLY difference from live is the fill
# assumption paper cannot test. Comparing live against the long-running paper book instead
# confounds sample, regime, sizing and concurrency all at once.
# Nothing needs to be set: twins are auto-derived from LIVE_STRATEGIES (tag + suffix) and stand
# down whenever live does. A twin never places a real order.
LIVE_PAPER_TWIN_ENABLED=true
LIVE_PAPER_TWIN_AUTO=true
# Explicit pairs override/extend the auto list: "mmsell10" or "mmsell10:mmsell10_pt2" (comma
# separated). Use an explicit tag to start a NEW epoch after retuning a live knob — a twin tag is
# single-use, and its started_at never moves.
LIVE_PAPER_TWINS=
LIVE_PAPER_TWIN_SUFFIX=_pt
# 0 = inherit the live book's own open cap (the faithful choice). Set >0 only to bound the extra
# paper bookkeeping on a book with a large live cap.
LIVE_PAPER_TWIN_MAX_OPEN_POSITIONS=0
# The per-candidate decision tape (incumbent paper book / twin / real live outcome + the gate
# that stopped live) that makes divergence attributable rather than guessed.
LIVE_PAPER_TWIN_PARITY_EVENTS=true
LIVE_PAPER_TWIN_PARITY_MAX=400
