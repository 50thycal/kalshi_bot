# ---------------------------------------------------------------------------
# Kalshi Trading Bot — environment configuration (Scanner MVP)
# Copy to .env for local runs. NEVER commit a real private key.
# ---------------------------------------------------------------------------

# Kalshi environment: demo | production. Start with demo until connectivity works.
KALSHI_ENV=demo

# Kalshi API credentials.
KALSHI_API_KEY_ID=your-api-key-id
# RSA private key (PEM). In Railway, paste as a single line with \n escapes,
# or provide a real multi-line value. Loaded with the cryptography library.
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Postgres connection string (Railway provides this automatically).
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Operating mode: scanner | paper | approval | live  (this MVP runs `scanner`).
BOT_MODE=scanner
# Master safety switch. Keep `true` until live trading is explicitly enabled.
KILL_SWITCH=true

# Risk limits. MAX_ORDER_SIZE is in contracts; the rest are in dollars.
MAX_ORDER_SIZE=1
MAX_MARKET_EXPOSURE=25
MAX_TOTAL_EXPOSURE=100
MAX_DAILY_LOSS=25

# Scan cadence.
SCAN_INTERVAL_SECONDS=300
# RUN_ONCE=true runs a single scan and exits; false loops forever.
RUN_ONCE=false

# --- Scanner tuning (optional; sane defaults live in kalshi_bot/config.py) ---
# Comma-separated target category names.
TARGET_CATEGORIES=Economics,Fed,Jobs,Financials
# Optional comma-separated series-ticker prefixes (e.g. KXFED,KXCPI) used when
# the market object has no usable `category` field.
TARGET_SERIES_PREFIXES=
MAX_SPREAD_CENTS=5
MIN_VOLUME=100
MIN_OPEN_INTEREST=50
MIN_HOURS_TO_CLOSE=1
MAX_MARKETS_PER_SCAN=25
ORDERBOOK_DEPTH=10
STALENESS_SECONDS=120
LOG_LEVEL=INFO
